<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniGames">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- configChanges：自绘 Canvas 游戏不需要在旋转/尺寸变化时重建 Activity。
             缺了它，旋转屏幕或进入分屏会销毁重建，进行中的对局与比分全部丢失。
             exported=false：只由本应用的 MainActivity 拉起，不对外开放。 -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale"
            android:exported="false" />
        <provider
            android:name=".update.UpdateFileProvider"
            android:authorities="${applicationId}.update-files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_file_paths" />
        </provider>
        <provider
            android:name=".engine.GamePlatformProvider"
            android:authorities="${applicationId}.game-platform"
            android:exported="false" />
        <activity
            android:name=".engine.EngineGameActivity"
            android:launchMode="singleTask"
            android:process=":godot"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false" />
        <!-- Godot 在独立进程运行，避免退出引擎时结束原生大厅。 -->
        <activity
            android:name=".engine.EngineLabActivity"
            android:process=":godot"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false" />
    </application>
</manifest>

