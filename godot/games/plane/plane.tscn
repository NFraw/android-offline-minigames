game_title = "星航防线"
game_rules = "拖动飞机自动开火；接补给升级双发/三发与快射，导弹为独立冷却副武器。漏接补给会消失。敌方导弹会预警、能击落，不会追踪。击败六关Boss即通关；5点耐久耗尽结束。"
